# Neon PostgreSQL — pooled connection used by the application at runtime
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Neon PostgreSQL — direct (non-pooled) connection used by the Prisma CLI for migrations
DIRECT_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""

# Canonical origin of the deployed application
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: isolated database used by `pnpm test:integration`.
# Defaults to the same server with the database name replaced by "goftam_test".
# TEST_DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/goftam_test?sslmode=require"

# Secret for POST/GET /api/internal/cleanup-rate-limits (scheduled RateLimit
# cleanup). Generate a long random value; point your scheduler (cron-job.org,
# GitHub Actions, Vercel Cron, etc.) at the endpoint every ~15 minutes with
# header `x-cleanup-secret: <value>` or `Authorization: Bearer <value>`.
# If unset, the endpoint always returns 401.
# RATE_LIMIT_CLEANUP_SECRET=""
